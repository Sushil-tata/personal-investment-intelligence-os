# Required: runtime environment label
PIIOS_ENV=dev

# Required: API prefix served by FastAPI
PIIOS_API_PREFIX=/api/v1

# Required: PostgreSQL DSN for product runtime
PIIOS_DB_URL=postgresql+psycopg://piios:piios@localhost:5432/piios_db

# Required: browser origins allowed for Streamlit frontend
PIIOS_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Required for frontend: backend API base URL
PIIOS_API_BASE=http://127.0.0.1:8000/api/v1

# Optional: vector store config
PIIOS_VECTOR_BACKEND=chroma
PIIOS_VECTOR_PATH=./.vector_store
PIIOS_VECTOR_COLLECTION=piios_research_memory

# Optional: model identity metadata
PIIOS_MODEL_VERSION=piios-model-0.3.2

# Optional: live market data controls
PIIOS_LIVE_MARKET_FEEDS=true
PIIOS_LIVE_TICKERS=NVDA,AVGO,MSFT,PG,KO,COST,TSLA,XOM,DE,UBER
